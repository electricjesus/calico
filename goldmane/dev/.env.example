# Goldmane Development Stack Environment Variables
# Copy this file to .env and customize as needed

# Goldmane Configuration
GOLDMANE_LOG_LEVEL=debug
GOLDMANE_PORT=443
GOLDMANE_AGGREGATION_WINDOW=15s
GOLDMANE_EMIT_AFTER_SECONDS=30

# OpenTelemetry Configuration
OTLP_SAMPLING_RATE=1.0
OTLP_LOG_LEVEL=debug
OTLP_SERVICE_NAME=goldmane
OTLP_SERVICE_NAMESPACE=dev
OTLP_SERVICE_VERSION=dev

# Flow Generation Configuration
FLOWGEN_FLOWS_PER_INTERVAL=300
FLOWGEN_NUM_NODES=30

# External Ports (modify if you have conflicts)
GOLDMANE_PORT_EXTERNAL=7443
GOLDMANE_HEALTH_PORT_EXTERNAL=8080
GOLDMANE_METRICS_PORT_EXTERNAL=9090
ECHO_SERVER_PORT_EXTERNAL=3000
JAEGER_UI_PORT_EXTERNAL=16686
OTEL_GRPC_PORT_EXTERNAL=4317
OTEL_HTTP_PORT_EXTERNAL=4318
OTEL_HEALTH_PORT_EXTERNAL=13133
OTEL_METRICS_PORT_EXTERNAL=8888
OTEL_ZPAGES_PORT_EXTERNAL=55679

# Docker Configuration
COMPOSE_PROJECT_NAME=goldmane-dev
