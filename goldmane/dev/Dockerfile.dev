FROM golang:1.24-alpine AS builder

# Install git and other build dependencies
RUN apk add --no-cache git

WORKDIR /src

# Copy source code first (needed for local module replacements)
COPY . .

# Download dependencies (after source is copied due to local replacements)
RUN go mod download

# Build goldmane binary
RUN CGO_ENABLED=0 GOOS=linux go build -o bin/goldmane ./goldmane/cmd/

# Build health binary
RUN CGO_ENABLED=0 GOOS=linux go build -o bin/health ./goldmane/cmd/health

# Final stage
FROM scratch

COPY --from=builder /src/bin/goldmane /goldmane
COPY --from=builder /src/bin/health /health
COPY goldmane/LICENSE /licenses/LICENSE

LABEL org.opencontainers.image.description="Goldmane is a flow aggregation service."
LABEL org.opencontainers.image.authors="maintainers@tigera.io"
LABEL org.opencontainers.image.source="https://github.com/projectcalico/calico"
LABEL org.opencontainers.image.title="Goldmane"
LABEL org.opencontainers.image.vendor="Project Calico"
LABEL org.opencontainers.image.licenses="Apache-2.0"

LABEL description="Goldmane is a flow aggregation service."
LABEL maintainer="maintainers@tigera.io"
LABEL name="Goldmane"
LABEL release=1
LABEL summary="Goldmane is a flow aggregation service."
LABEL vendor="Project Calico"

USER 10001:10001

CMD ["/goldmane"]
